{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "mainBinaryName": "Folio",
  "identifier": "org.sleepycoffee.folio",
  "build": {
    "frontendDist": "../shell/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://folio.localhost",
        "media-src": "'self' blob: http://folio.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Folio",
    "category": "Productivity",
    "shortDescription": "Локальная вики в духе Confluence",
    "longDescription": "Страницы лежат Markdown-файлами у вас на диске, у каждого пространства своя история в git.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["folio"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NEQyQTMzMTdDQUZGNDAKUldSQS84b1hNeXBOdVRJTzhMWWFlcGRwNks5dTZHVjg5dGxNRFZ6UWVwMFRTRWNSUGpXdVB6VWQK",
      "endpoints": ["https://github.com/Dubious-Idea/folio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
